# Copy this file to .env.local and fill in your values

# MongoDB connection string
# Local: mongodb://localhost:27017/temple-heritage
# Atlas: mongodb+srv://<user>:<password>@cluster.mongodb.net/temple-heritage
MONGODB_URI=mongodb://localhost:27017/temple-heritage

# Next.js
NEXTAUTH_SECRET=your-secret-key-here
NEXTAUTH_URL=http://localhost:3000

# Optional: Admin credentials (for simple auth)
ADMIN_EMAIL=admin@templeheritage.in
ADMIN_PASSWORD=change-this-password

# Optional: Cloudinary for image uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: Google Maps API (for future map feature)
NEXT_PUBLIC_MAPS_API_KEY=
